# Maintainer: Rob de Jong <bh808303@hotmail.com>
pkgname=yt-pplayer
pkgver=0.1.0
pkgrel=1
pkgdesc="YouTube Playlist Player for the terminal: your playlists, ad-free, via yt-dlp and mpv"
arch=('any')
url="https://github.com/bh808303/yt-pplayer"
license=('MIT')
depends=('python' 'python-rich' 'python-textual' 'python-secretstorage' 'yt-dlp' 'mpv')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('mpv-mpris: media keys and desktop media widgets'
            'jq: for yt-pplayer-toggle (show/hide on Hyprland / Omarchy)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ad0eb0bee54ca2a587b15b96c09d1053d7c3ee41a5f292981550985077691071')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm755 omarchy/yt-pplayer-toggle "$pkgdir/usr/bin/yt-pplayer-toggle"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
